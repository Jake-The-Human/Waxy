.pio_version 0
.program i2s_32bit

.side_set 2 ; Allocate 2 bits for side-set (BCLK and WCLK)

.wrap_target
    ; Left Channel (WCLK = 0)
    out pins, 1 side 0b00 ; 1, MSB, BCLK = 1, WCLK = 0
    out pins, 1 side 0b10 ; 2,      BCLK = 0, WCLK = 0
    out pins, 1 side 0b00 ; 3
    out pins, 1 side 0b10 ; 4
    out pins, 1 side 0b00 ; 5
    out pins, 1 side 0b10 ; 6
    out pins, 1 side 0b00 ; 7
    out pins, 1 side 0b10 ; 8
    out pins, 1 side 0b00 ; 9
    out pins, 1 side 0b10 ; 10
    out pins, 1 side 0b00 ; 11
    out pins, 1 side 0b10 ; 12
    out pins, 1 side 0b00 ; 13
    out pins, 1 side 0b10 ; 14
    out pins, 1 side 0b00 ; 15
    out pins, 1 side 0b10 ; 16
    out pins, 1 side 0b00 ; 17
    out pins, 1 side 0b10 ; 18
    out pins, 1 side 0b00 ; 19
    out pins, 1 side 0b10 ; 20
    out pins, 1 side 0b00 ; 21
    out pins, 1 side 0b10 ; 22
    out pins, 1 side 0b00 ; 23
    out pins, 1 side 0b10 ; 24
    out pins, 1 side 0b00 ; 25
    out pins, 1 side 0b10 ; 26
    out pins, 1 side 0b00 ; 27
    out pins, 1 side 0b10 ; 28
    out pins, 1 side 0b00 ; 29
    out pins, 1 side 0b10 ; 30
    out pins, 1 side 0b00 ; 31
    out pins, 1 side 0b11 ; 32, LSB, BCLK = 1, WCLK = 1
    ; Right Channel (WCLK = 1)
    out pins, 1 side 0b01 ; 1, MSB, BCLK = 0, WCLK = 1
    out pins, 1 side 0b11 ; 2,      BCLK = 1, WCLK = 1
    out pins, 1 side 0b01 ; 3
    out pins, 1 side 0b11 ; 4
    out pins, 1 side 0b01 ; 5
    out pins, 1 side 0b11 ; 6
    out pins, 1 side 0b01 ; 7
    out pins, 1 side 0b11 ; 8
    out pins, 1 side 0b01 ; 9
    out pins, 1 side 0b11 ; 10
    out pins, 1 side 0b01 ; 11
    out pins, 1 side 0b11 ; 12
    out pins, 1 side 0b01 ; 13
    out pins, 1 side 0b11 ; 14
    out pins, 1 side 0b01 ; 15
    out pins, 1 side 0b10 ; 16
    out pins, 1 side 0b01 ; 17
    out pins, 1 side 0b11 ; 18
    out pins, 1 side 0b01 ; 19
    out pins, 1 side 0b11 ; 20
    out pins, 1 side 0b01 ; 21
    out pins, 1 side 0b11 ; 22
    out pins, 1 side 0b01 ; 23
    out pins, 1 side 0b11 ; 24
    out pins, 1 side 0b01 ; 25
    out pins, 1 side 0b11 ; 26
    out pins, 1 side 0b01 ; 27
    out pins, 1 side 0b11 ; 28
    out pins, 1 side 0b01 ; 29
    out pins, 1 side 0b11 ; 30
    out pins, 1 side 0b01 ; 31
    out pins, 1 side 0b10 ; 32, LSB, BCLK = 1, WCLK = 0
.wrap
