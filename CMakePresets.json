{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "FAMILY": "rp2040",
                "BOARD": "feather_rp2040_max3421"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "nativeToolOptions": [
                "DEBUG=1",
                "LOG=1",
                "BOARD=feather_rp2040_max3421"
            ]
        }
    ]
}